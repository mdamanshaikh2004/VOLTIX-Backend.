PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/voltix

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Format: redis://default:PASSWORD@HOST:PORT  (do NOT paste a redis-cli -u command here)
REDIS_URL=redis://default:password@host:port

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="VOLTIX <no-reply@your-domain.com>"

# Admin account must be provisioned securely for production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_FIRST_NAME=VOLTIX
ADMIN_LAST_NAME=Admin

# Development auth rate limiting
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000

# OTP security
EMAIL_OTP_TTL_MINUTES=10
EMAIL_VERIFICATION_TTL_MINUTES=15
